# Gemini API key used ONLY by the server. Never put this in client-side code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Model used by the CRM AI endpoints.
GEMINI_MODEL="gemini-3.7-flash"

# Firebase Web API key. This key is also present in firebase-applet-config.json,
# but keeping it as an environment variable is convenient for deployment.
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"

# Optional: URL where the app is hosted.
APP_URL="YOUR_APP_URL"
