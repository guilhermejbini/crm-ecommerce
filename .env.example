# Gemini API key used ONLY by the server. Never put this in client-side code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Model used by the CRM AI endpoints.
GEMINI_MODEL="gemini-3.7-flash"

# Firebase Web API key. This key is also present in firebase-applet-config.json,
# but keeping it as an environment variable is convenient for deployment.
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"

# Optional: URL where the app is hosted.
APP_URL="YOUR_APP_URL"

# ---------------------------------------------------------------
# Pesquisa de satisfação pós-compra (WhatsApp Business / Cloud API da Meta)
# Sem WHATSAPP_TOKEN e WHATSAPP_PHONE_NUMBER_ID o CRM roda em MODO TESTE (não envia nada).
# Nunca coloque estes valores no código do navegador.
# ---------------------------------------------------------------
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Recebimento das respostas (webhook): token de verificação escolhido por vocês e o "App Secret" do app na Meta.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Token que o Cloud Scheduler manda no cabeçalho X-Survey-Cron-Token ao chamar POST /api/survey/run.
SURVEY_CRON_TOKEN=""
# "off" desliga a verificação interna a cada 15 minutos (o Cloud Scheduler continua funcionando).
SURVEY_INTERNAL_TIMER=""
